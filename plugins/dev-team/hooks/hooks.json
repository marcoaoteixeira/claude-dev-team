{
  "description": "Review gate: denies git push unless development-pipeline recorded a passed review and QA for the pushed commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/require-review.cjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
